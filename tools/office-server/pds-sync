#!/bin/bash
# Keep the office server's copy on the newest main. Cron runs it every minute.
# Fetches the public repo (no keys), and when main moved, or a tracked file differs, resets the copy
# to it. .env and other ignored or untracked files are left alone; the share store lives outside the
# repo (~/pds-data). When the server's code moved (api/ or tools/office-server/), it reinstalls these
# two scripts from the repo and restarts the server, so a push reaches the API too.
# Installed as ~/pds-deploy/pds-sync.
R=$HOME/Provident-Design-Studio
D=$HOME/pds-deploy
L=$D/logs/sync.log
mkdir -p "$(dirname "$L")"
exec 9>"$D/.sync.lock"; flock -n 9 || exit 0
cd "$R" || exit 1
if ! timeout 60 git fetch -q https://github.com/kelvin-inigo/Provident-Design-Studio.git main; then
  echo "$(date '+%F %T') fetch failed" >>"$L"; exit 1
fi
new=$(git rev-parse FETCH_HEAD); cur=$(git rev-parse HEAD)
[ "$new" = "$cur" ] && [ -z "$(git status --porcelain --untracked-files=no)" ] && exit 0
if git checkout -q -f -B main "$new" && git reset -q --hard "$new"; then
  echo "$(date '+%F %T') ${cur:0:7} -> ${new:0:7}" >>"$L"
  if [ -n "$(git diff --name-only "$cur" "$new" -- api tools/office-server 2>/dev/null)" ] || [ "$cur" = "$new" ]; then
    for f in pds-studio pds-sync; do
      cp "$R/tools/office-server/$f" "$D/$f.new" && chmod +x "$D/$f.new" && mv -f "$D/$f.new" "$D/$f"
    done
    "$D/pds-studio" restart-server >>"$L" 2>&1
    echo "$(date '+%F %T') server code changed: restarted" >>"$L"
  fi
else
  echo "$(date '+%F %T') update to ${new:0:7} failed" >>"$L"
fi
