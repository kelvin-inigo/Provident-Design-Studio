      "css": ".ds-clear{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:16px;padding:20px 22px;border-radius:16px;background:var(--ps-fill,#282B31);color:var(--ps-ink,#fff);font-family:'Google Sans Flex',system-ui,sans-serif}.ds-disc{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--ps-good,#22B457);color:var(--ps-app,#131519)}.ds-clear b{display:block;font:500 17px/1.3 inherit}.ds-clear span{display:block;margin-top:2px;font:400 14px/1.45 inherit;color:var(--ps-ink-2,#C3C8D0)}"
    }
