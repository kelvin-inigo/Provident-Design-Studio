      "css": ".ds-btn-primary{height:36px;padding:10px 16px;border:0;border-radius:9999px;background:var(--ps-accent-h,#1A2942);color:var(--ps-primary-i,#fff);font:600 14px/1 'Google Sans Flex',system-ui,sans-serif;letter-spacing:.16px;cursor:pointer;transition:background-color 150ms cubic-bezier(0.2,0,0,1)}.ds-btn-primary:hover{background:var(--ps-accent-h2,#22355A)}.ds-btn-primary:focus-visible{outline:2px solid var(--ps-ink,#fff);outline-offset:2px}"
