      "css": ".ds-btn-quiet{height:36px;padding:10px 18px;border:0;border-radius:9999px;background:transparent;color:var(--ps-ink-2,#C3C8D0);font:600 14px/1 'Google Sans Flex',system-ui,sans-serif;letter-spacing:.16px;cursor:pointer;transition:background-color 150ms cubic-bezier(0.2,0,0,1),color 150ms}.ds-btn-quiet:hover{background:var(--ps-fill,#282B31);color:var(--ps-ink,#fff)}.ds-btn-quiet:focus-visible{outline:2px solid var(--ps-ink,#fff);outline-offset:2px}"
    },
    {
      "name": "Home Switch",
      "kind": "nav",
      "refersTo": "switch-tab",
      "description": "Two doors on one pill track: My turn and Start a post. The chosen half takes the resting navy.",
      "html": "<div class=\"ds-sw\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\" data-on>My turn</button><button role=\"tab\" aria-selected=\"false\">Start a post</button></div>",
      "css": ".ds-sw{display:inline-flex;gap:4px;padding:4px;border-radius:9999px;background:var(--ps-fill,#282B31)}.ds-sw button{height:40px;padding:0 20px;border:0;border-radius:9999px;background:transparent;color:var(--ps-ink-2,#C3C8D0);font:600 14px/1 'Google Sans Flex',system-ui,sans-serif;letter-spacing:.16px;cursor:pointer;transition:background-color 150ms cubic-bezier(0.2,0,0,1),color 150ms}.ds-sw button:hover{color:var(--ps-ink,#fff);background:var(--ps-fill-h,#31353C)}.ds-sw button[data-on]{background:var(--ps-accent,#243352);color:var(--ps-accent-i,#fff)}.ds-sw button:focus-visible{outline:2px solid var(--ps-ink,#fff);outline-offset:2px}"
    },
    {
      "name": "Queue Row",
      "kind": "card",
      "refersTo": "queue-row",
      "description": "One post's next step: render, name, step segments, due date, one action.",
      "html": "<div class=\"ds-row\"><span class=\"ds-th\"></span><div class=\"ds-t\"><b>Top agents of October</b><span class=\"ds-st\"><span class=\"ds-segs\"><i data-s=\"done\"></i><i data-s=\"cur\"></i><i></i><i></i></span><em>Design</em> Started by you · 17 min ago</span></div><span class=\"ds-due\">Due Sunday</span><button class=\"ds-go\">Send to copy check</button></div>",
      "css": ".ds-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;align-items:center;column-gap:20px;padding:14px 16px 14px 14px;border-radius:16px;background:var(--ps-card,#1D2024);box-shadow:inset 0 0 0 1px var(--ps-hair,rgba(148,154,166,.16));color:var(--ps-ink,#fff);font-family:'Google Sans Flex',system-ui,sans-serif;transition:box-shadow 150ms cubic-bezier(0.2,0,0,1)}.ds-row:hover{box-shadow:inset 0 0 0 1px var(--ps-line,rgba(148,154,166,.24))}.ds-th{width:72px;aspect-ratio:3/4;border-radius:8px;background:var(--ps-fill-h,#31353C)}.ds-t{display:grid;gap:6px;min-width:0}.ds-t b{font:500 18px/1.3 inherit}.ds-st{display:flex;align-items:center;gap:10px;font:400 13px/1.3 inherit;color:var(--ps-ink-2,#C3C8D0)}.ds-st em{font-style:normal;font-weight:500;color:var(--ps-ink,#fff)}.ds-segs{display:inline-flex;gap:3px}.ds-segs i{width:14px;height:4px;border-radius:9999px;background:var(--ps-line,rgba(148,154,166,.24))}.ds-segs i[data-s=done]{background:var(--ps-good,#22B457)}.ds-segs i[data-s=cur]{background:var(--ps-link,#879CC5)}.ds-due{display:inline-flex;align-items:center;gap:6px;font:500 13px/1 inherit;color:var(--ps-ink-2,#C3C8D0)}.ds-due::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--ps-dim,#949AA6)}.ds-go{height:36px;padding:10px 16px;border:0;border-radius:9999px;background:var(--ps-accent-h,#1A2942);color:#fff;font:600 14px/1 inherit;letter-spacing:.16px}"
    },
