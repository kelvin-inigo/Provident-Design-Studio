# Claude Code / local agent permissions & machine-specific configs
.claude/*.local.json

# Background-removal service (tools/rembg). The private Python environment and
# the ~1.1GB of model weights are rebuilt by tools/rembg/install.sh; the source,
# the server and the scripts are tracked.
tools/rembg/.venv/
tools/rembg/**/__pycache__/

# Claude Code working files — backups, patch scripts and probe outputs. Never part of the project.
scratchpad/

# Components made by the /cas-component skill. They carry campaign copy, so they stay on this computer.
custom-components/

# Meta Ads kit (tools/meta-ads). Credentials, the account config and every report or dry-run
# artifact stay on this computer — the repo is public.
tools/meta-ads/kit/.env
tools/meta-ads/kit/.env.*
!tools/meta-ads/kit/.env.example
tools/meta-ads/kit/ad-config.json
tools/meta-ads/kit/local/
tools/meta-ads/kit/workspace/
