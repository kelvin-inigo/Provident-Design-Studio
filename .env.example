# Provident Design Studio — environment variables.
#
# Copy to .env (git-ignored) and fill in what you need. Nothing here is read automatically:
# load it into a shell before running a local tool —
#     set -a; source .env; set +a
# Production values live in Vercel (Settings › Environment Variables), never in this repo.
# Leave a line commented out rather than blank: an empty value beats the code's defaults.

# ── Share store (api/share.py) — Upstash Redis over REST ─────────────────────────────────
# Vercel's Storage tab adds these (sometimes with a prefix; any name ending in these works).
# Unset locally → tools/share-dev/serve.py runs on an in-memory store. docs/share-links-setup.md
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=          # alternative names for the same two
# UPSTASH_REDIS_REST_TOKEN=
# SHARE_DEV=1                      # force the in-memory store
# SHARE_DEV_QUOTA=0                # dev only: fake a full store
# SHARE_STORE_MB=250               # store size the quota warning measures against
# SHARE_ADMIN_KEY=                 # share-admin.html key — any long random string

# ── Studio sign-in and roles (api/share.py) — docs/studio-access-setup.md ────────────────
# ACCESS_ADMIN=                    # the admin's Google account
# ACCESS_ADMIN_ROLE=designer
# ACCESS_DOMAIN=providentestate.com
# ACCESS_GOOGLE_BASE=https://www.googleapis.com

# ── Google refresh tokens (api/gauth.py) — docs/google-drive-setup.md ───────────────────
# GOOGLE_CLIENT_ID=                # defaults to the studio's OAuth client
# GOOGLE_CLIENT_SECRET=
# GAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# GAUTH_REVOKE_URL=https://oauth2.googleapis.com/revoke
# GAUTH_REAL=1                     # share dev server: use the real secret and Google, not the mock

# ── Content Hub ──────────────────────────────────────────────────────────────────────────
# HUB_PUSH_KEY=                    # api/share.py: key the hub pushes with (dev: dev-hub-push)
# HUB_IMPORT_TOKEN=                # /hub-design-queue skill; else ~/.config/provident/hub-token

# ── Roam notifications (hand-over in CAS) ────────────────────────────────────────────────
# ROAM_API_KEY=                    # Roam API key — server side only, never in a studio file
# ROAM_GROUP_ID=                   # channel; default Design Task Hub
# ROAM_TAG_ENG=                    # tagged on English (default Sana, exec1.content)
# ROAM_TAG_ARB=                    # tagged on Arabic (default Fatema, exec2.content)
# ROAM_TAG_ALL=                    # always tagged, comma-separated (default Dennis, digitalmarketing.lead1)
# ROAM_DRY=1                       # build the message but do not post it (testing)

# ── AEL copywriter (branch cas-framework) — TokenRouter ─────────────────────────────────
# TOKENROUTER_API_KEY=             # server side only (api/share.py op aelcopy)
# AEL_MODEL=openai/gpt-6-sol       # also: anthropic/claude-sonnet-5.5, anthropic/claude-haiku-5.5

# ── Dashboard SSO (dashboard_sso_guard.py) ───────────────────────────────────────────────
# PROVIDENT_SSO_SECRET=            # must match the dashboard app's secret exactly

# ── Studio MCP server (tools/studio-mcp) ─────────────────────────────────────────────────
# PROVIDENT_STUDIO_ROOT=           # defaults to this repo
# PROVIDENT_STUDIO_OUT=            # where exports land
# PROVIDENT_CHROME=                # path to a Chrome binary

# ── Cut-out service (tools/rembg) ────────────────────────────────────────────────────────
# CUTOUT_PORT=7311
# CUTOUT_MODEL=bria-rmbg
# CUTOUT_REFINE=vitmatte
# CUTOUT_PROVIDER=cpu
# CUTOUT_IDLE_EXIT=10
# U2NET_HOME=                      # model weights folder
